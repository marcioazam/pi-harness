# Copy to ~/.pi/agent/local.env and run: chmod 600 ~/.pi/agent/local.env
# bin/pi reads it line by line (never sourced or evaluated): only KEY=VALUE with a key
# listed below; values are literal ($ and backticks are not expanded; one pair of
# surrounding quotes is stripped). The file must be owned by you with mode 0600 or 0400,
# otherwise it is ignored with a warning. Variables already set in the environment win.
# Do not put API keys here: they go in the environment or mcp.json placeholders.

# 1 = bypass permission prompts (autonomous mode); default 0. Also: pi --bypass / pi --safe.
#PI_BYPASS_PERMISSIONS=0
# Token count that triggers compaction (default 250000).
#PI_COMPACT_AT=250000
# 1 = hide the "Ponytail loaded" startup line (default 1).
#PONYTAIL_QUIET_STARTUP=1
# Absolute paths of your knowledge / graphs vaults (optional).
#PI_KNOWLEDGE_VAULT=/path/to/vault
#PI_GRAPHS_VAULT=/path/to/graphs
# Root where codegraph auto-indexes repositories (optional).
#CODEGRAPH_AUTO_ROOT=/path/to/code
# 0 = disable the automatic respawn of a crashed foreground subagent.
#PI_SUBAGENT_RESPAWN=1
