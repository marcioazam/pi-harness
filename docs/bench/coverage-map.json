      ],
      "covered_by_vanilla": true
    },
    "sessions_resume": {
      "paths": [
        "extensions/auto-resume/**"
      ],
      "covered_by_vanilla": false
    },
    "compaction": {
      "paths": [
        "extensions/compact-at-400k.ts"
      ],
      "covered_by_vanilla": false
    },
    "permission_modes": {
      "paths": [
        "extensions/bypass-permissions/**",
