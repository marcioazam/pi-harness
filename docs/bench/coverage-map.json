{
  "_doc": "AC8: capability -> repo path globs; covered_by_vanilla = exercised by the vanilla baseline suites (S4 plan, S5 multi-agent, S1 headless). A PR touching paths of an uncovered capability gets the suggestion 'retest vanilla'.",
  "capabilities": {
    "headless_json": {
      "paths": [
        "bench/arms/**"
      ],
      "covered_by_vanilla": true
    },
    "budget_cap": {
      "paths": [
        "bench/**",
        "claude-home/bin/**"
      ],
      "covered_by_vanilla": false
    },
    "hooks": {
      "paths": [
        "claude-home/hooks/**"
      ],
      "covered_by_vanilla": false
    },
    "skills": {
      "paths": [
        "claude-home/skills/**"
      ],
      "covered_by_vanilla": false
    },
    "mcp": {
      "paths": [
        "mcp.json.example",
        "claude-home/rules-ref/research-and-tools.md"
      ],
      "covered_by_vanilla": false
    },
    "subagents": {
      "paths": [
        "claude-home/agents/**"
      ],
      "covered_by_vanilla": true
    },
    "teams": {
      "paths": [
        "claude-home/skills/swarm-orchestration/**"
      ],
      "covered_by_vanilla": true
    },
    "plan_mode": {
      "paths": [
        "extensions/plan-gate.ts",
