      ],
      "covered_by_vanilla": false
    },
    "rewind": {
      "paths": [
        "claude-home/patches/**"
      ],
      "covered_by_vanilla": false
    },
    "output_styles": {
      "paths": [],
      "covered_by_vanilla": false
    },
    "extensions": {
      "paths": [
        "extensions/**",
        "npm/**",
        "patches/**"
      ],
      "covered_by_vanilla": false
    },
    "lsp": {
      "paths": [
        "lsp.json.example"
      ],
      "covered_by_vanilla": false
    },
    "codemode": {
      "paths": [
        "extensions/**codemode**"
      ],
      "covered_by_vanilla": false
    }
  }
}
