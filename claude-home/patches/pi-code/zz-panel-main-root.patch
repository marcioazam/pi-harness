+/** Custo da sessão: soma de usage.cost.total das mensagens do assistente no ramo atual; indisponível = undefined. */
+function branchCost(ctx: ExtensionContext): number | undefined {
+  try {
+    let total = 0
+    for (const entry of ctx.sessionManager.getBranch() as Array<{ type?: string; message?: { role?: string; usage?: { cost?: { total?: number } } } }>) {
+      if (entry.type === 'message' && entry.message?.role === 'assistant') total += entry.message.usage?.cost?.total ?? 0
+    }
+    return total
+  } catch {
+    return undefined
+  }
+}
