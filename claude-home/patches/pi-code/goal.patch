+/** Pure rendering helpers for the /goal UI (transcript lines, footer text, status panel),
+ * modeled on Claude Code's goal_status attachment and /goal panel. */
+import { formatDuration, formatTokens, type GoalSummary, summaryText } from './goal-evaluator.ts'
+
+export interface GoalMessageDetails {
+  kind: 'set' | 'not_met' | 'achieved' | 'failed' | 'cleared' | 'checkin' | 'retry' | 'error'
+  condition?: string
+  reason?: string
+  summary?: GoalSummary
+  turn?: number
+}
+
+export interface GoalStyle {
+  accent: (s: string) => string
+  success: (s: string) => string
+  error: (s: string) => string
+  warning: (s: string) => string
+  dim: (s: string) => string
+  bold?: (s: string) => string
+}
+
+/** Footer text: the elapsed part is left out during the first second. */
+export function indicatorText(elapsedMs: number): string {
+  return elapsedMs < 1000 ? '◎ /goal active' : `◎ /goal active (${formatDuration(elapsedMs)})`
+}
+
+const firstLine = (s: string): string => s.split('\n', 1)[0] ?? ''
+
+/** Lines of one goal transcript message; `hint` is the styled expand hint. */
+export function goalMessageLines(content: string, details: GoalMessageDetails | undefined, expanded: boolean, style: GoalStyle, hint: string): string[] {
+  const { dim } = style
+  const stats = (d: GoalMessageDetails): string => (d.summary ? dim(` (${summaryText(d.summary)})`) : '')
+  const extra = (d: GoalMessageDetails): string[] => [
+    ...(d.condition ? [dim(`  Goal: ${d.condition}`)] : []),
+    ...(d.reason ? [dim(`  Reason: ${d.reason}`)] : []),
+    ...(d.summary?.evaluator ? [dim(`  Evaluator: ${d.summary.evaluator}`)] : []),
+  ]
+  const fallback = (): string[] => (expanded ? [dim(content)] : [dim(firstLine(content)) + ' ' + hint])
+  if (!details) return fallback()
+  switch (details.kind) {
+    case 'achieved':
+      return [style.success('✓ Goal achieved') + stats(details) + (expanded ? '' : ' ' + hint), ...(expanded ? extra(details) : [])]
+    case 'failed':
+      return [
+        style.error('✗ Goal could not be achieved') + stats(details),
+        ...(expanded ? extra(details) : details.reason ? [dim(`  ${details.reason}`)] : []),
+      ]
+    case 'not_met':
+      return [dim('○ Goal not yet met… continuing') + (expanded ? '' : ' ' + hint), ...(expanded ? extra(details) : [])]
+    case 'set':
+      return [style.accent('◎') + ` Goal set: ${details.condition ?? ''}`, ...(expanded ? [dim(content)] : [])]
+    case 'cleared':
+      return [dim(`Goal cleared: ${details.condition ?? firstLine(content)}`)]
+    case 'error':
+      return [style.warning(firstLine(content))]
+    default:
+      return fallback()
+  }
+}
+
+export interface GoalPanelState {
+  active?: GoalSummary
+  achieved?: GoalSummary
+}
+
+/** Content lines of the /goal status panel (the component adds the border and wrapping). */
+export function goalPanelLines(state: GoalPanelState, style: GoalStyle): string[] {
+  const { dim } = style
+  const bold = style.bold ?? ((s: string) => s)
+  const { active, achieved } = state
+  const s = active ?? achieved
+  if (!s) return [bold('Goal'), '', 'No goal set ' + dim('/goal <condition> to set one'), '', dim('esc to dismiss')]
+  const stats = active
+    ? `running ${formatDuration(s.durationMs)}${s.iterations > 0 ? ` · ${s.iterations} ${s.iterations === 1 ? 'turn' : 'turns'}` : ''} · ${formatTokens(s.tokens)} tokens`
+    : summaryText(s)
+  return [
+    active ? bold(style.accent('◎ Goal active')) : bold(style.success('✓ Goal achieved')),
+    dim(stats),
+    '',
+    `${dim('Goal:')} ${s.condition}`,
+    ...(s.lastReason ? [`${dim('Last check:')} ${s.lastReason}`] : []),
+    ...(active && s.evaluator ? [`${dim('Evaluator:')} ${s.evaluator}`] : []),
+    '',
+    dim(active ? '/goal clear to stop early · esc to dismiss' : '/goal <condition> to set another · esc to dismiss'),
+  ]
+}
