#!/usr/bin/env bash
# Arm cc-vanilla: Claude Code at a pinned version, isolated profile, effort medium, auto permission mode.
# CLAUDE_CODE_EFFORT_LEVEL wins over --effort and settings (CC env-vars docs).
set -euo pipefail
# shellcheck source=bench/arms/oauth-token.sh
. "$(dirname "$(readlink -f "$0")")/oauth-token.sh"
token=$(bench_oauth_token)
cfg="${BENCH_CC_VANILLA_DIR:-$HOME/.claude-vanilla-ab}"
[ -f "$cfg/settings.json" ] || {
  mkdir -p "$cfg"
  printf '%s\n' '{"effortLevel":"medium","permissions":{"defaultMode":"auto"}}' >"$cfg/settings.json"
}
export CLAUDE_CONFIG_DIR="$cfg" CLAUDE_CODE_EFFORT_LEVEL=medium DISABLE_AUTOUPDATER=1 CLAUDE_CODE_OAUTH_TOKEN="$token"
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
exec "${BENCH_CC_BIN:-$HOME/.local/share/claude/versions/2.1.323}" "$@"
